      <!-- ============ Security ============ -->
      <section id="security" class="py-6 sm:py-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-5">🔐 Modern Security</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
          <div class="bg-white rounded-2xl shadow-sm p-5">
            <h3 class="text-lg sm:text-xl font-semibold text-blue-700 mb-2">OAuth 2.0 / OIDC</h3>
            <p class="text-gray-700 text-sm sm:text-base leading-relaxed">
              Integrates with Okta, Azure AD, Keycloak. Kafka 4.1 adds <strong>JWT bearer grant type</strong> (KIP-1139) for service-to-service auth without client secrets.
            </p>
          </div>

          <div class="bg-white rounded-2xl shadow-sm p-5">
            <h3 class="text-lg sm:text-xl font-semibold text-green-700 mb-2">mTLS</h3>
            <p class="text-gray-700 text-sm sm:text-base leading-relaxed">
              Strong transport-level security with client certificates. Works well if you already have PKI infrastructure.
            </p>
          </div>

          <div class="bg-white rounded-2xl shadow-sm p-5 sm:col-span-2">
            <h3 class="text-lg sm:text-xl font-semibold text-purple-700 mb-2">Zero-Trust Model</h3>
            <p class="text-gray-700 text-sm sm:text-base leading-relaxed">
              Use <strong>strong authentication</strong> (mTLS, OAuth, SCRAM-SHA-512) — never rely on IP allowlists alone. Enforce ACLs at the topic level; separate principals for producers and consumers.
            </p>
          </div>
        </div>
      </section>

